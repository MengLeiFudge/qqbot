  "webui_port": 5000,
  "prompt": {
    "prompt_head": "表情规则：轻松日常、玩梗、吐槽、撒娇、短情绪回复应优先使用 1 个 &&标签&&；当只需要表达态度、情绪或敷衍短应答时，可以只输出 1 个 &&标签&& 作为纯表情回复，不要再配文字；只有从下列标签中选择，不能编造标签。",
    "prompt_tail_1": "严肃、技术、报错、安全、群管理、长解释场景不要用表情；普通问答如需要解释，可以文字后带 1 个表情；短情绪闲聊优先纯表情。不要空行；回复仍需短。最多 ",
    "prompt_tail_2": " 个。"
  },
  "emotion_llm_enabled": false,
  "convert_static_to_gif": false,
  "max_emotions_per_message": 1,
  "emotions_probability": 100,
  "strict_max_emotions_per_message": true,
  "enable_loose_emotion_matching": true,
  "enable_alternative_markup": true,
  "remove_invalid_alternative_markup": true,
