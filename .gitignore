# Local agent and editor state
/.codex/
/.agents/
/.idea/
.vscode/

# Python and tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.cache/

# Local environments
.venv/
venv/
env/
ENV/

# Generic runtime output
*.log
*.pid
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.tmp
*.temp
*.bak
*.backup
*.swp
*.swo
*.zip
*.tar
*.tar.gz
*.7z
*.rar

# Root-local runtime directories
/data/
/logs/
/temp/
/tmp/

# NapCat is managed by qqbot, but its package, login state and logs stay local.
/napcat/*
!/napcat/accounts.json
!/napcat/README.md
!/napcat/scripts/
!/napcat/scripts/**
/napcat/data/
/napcat/onekey/

# Local dependency caches
/node_modules/
.pnpm-store/
