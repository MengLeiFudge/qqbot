[bot]
host = "127.0.0.1"
port = 8080
command_start = "/"
log_level = "INFO"
author_qq = 10000
author_name = "author"
timezone = "Asia/Shanghai"

[onebot]
ws_path = "/onebot/v11/ws"

[paths]
data_root = "./run"
arc_assets_root = "D:/path/to/Arcaea"
arcaea_record_root = "D:/path/to/arcaeaRecord"
arcaea_record_maven = "C:/path/to/maven/bin/mvn.cmd"
arcaea_record_java_home = "C:/path/to/jdk"

[ai]
default_profile = "codex-everywhere"
max_context_messages = 12
group_context_messages = 30
show_metrics = false
bot_name = "QQBot"
first_attempt_timeout_seconds = 0
max_attempts = 2
memory_enabled = true
memory_search_limit = 6
memory_context_chars = 1200
embedding_enabled = false
embedding_base_url = "https://api.openai.com/v1"
embedding_model = "text-embedding-3-small"
embedding_api_key_env = "QQBOT_OPENAI_API_KEY"
embedding_timeout_seconds = 45

[ai.providers.codex-everywhere]
provider = "openai_compatible"
base_url = "https://codex-everywhere.com/v1"
model = "gpt-5.4-mini"
api_key_env = "QQBOT_AI_KEY_CODEX_EVERYWHERE"
timeout_seconds = 45
max_output_tokens = 4096
supports_vision = false

[ai.providers.openrouter-icu]
provider = "openai_compatible"
base_url = "https://rehdasu.cn/v1"
model = "gpt-5.4-mini"
api_key_env = "QQBOT_AI_KEY_OPENROUTER_ICU"
timeout_seconds = 45
max_output_tokens = 4096
supports_vision = false

[ai.providers.openrouter-icu.extra_body]
reasoning = { effort = "high" }

[ai.providers.rightcodes]
provider = "openai_compatible"
base_url = "https://right.codes/codex/v1"
model = "gpt-5.4-mini"
api_key_env = "QQBOT_AI_KEY_RIGHTCODES"
timeout_seconds = 45
max_output_tokens = 4096
supports_vision = false

[ai.providers.rightcodes.extra_body]
reasoning = { effort = "high" }

[ai.providers.hicode]
provider = "openai_compatible"
base_url = "https://www.hi-code.cc/v1"
model = "gpt-5.4-mini"
api_key_env = "QQBOT_AI_KEY_HICODE"
timeout_seconds = 45
max_output_tokens = 4096
supports_vision = false

[ai.providers.routin]
provider = "openai_compatible"
base_url = "https://api.routin.ai/v1"
model = "gpt-5.2"
api_key_env = "QQBOT_AI_KEY_ROUTIN"
timeout_seconds = 45
max_output_tokens = 4096
supports_vision = false

[ai.providers.tokenflux]
provider = "openai_compatible"
base_url = "https://example.com/v1"
model = "example-model"
api_key_env = "QQBOT_AI_KEY_TOKENFLUX"
timeout_seconds = 45
max_output_tokens = 4096
supports_vision = false

[ai.providers.xiaomi]
provider = "xiaomi_mimo"
base_url = "https://token-plan-cn.xiaomimimo.com/v1"
model = "mimo-v2.5"
vision_model = "mimo-v2.5"
api_key_env = "QQBOT_AI_KEY_XIAOMI"
timeout_seconds = 45
max_output_tokens = 4096
supports_vision = true

# RightCodes 生图使用 QQBOT_AI_KEY_RIGHTCODES，命令示例：
# @机器人 棉花生图 一只糖果猫娘
# @机器人 棉花糖生图 [nano-banana-pro] 赛博城市
# 棉花生图一只糖果猫娘
